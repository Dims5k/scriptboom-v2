{
  "rewrites": [
    {
      "source": "/bienvenue",
      "destination": "/bienvenue.html"
    },
    {
      "source": "/pexels/:path*",
      "destination": "https://videos.pexels.com/:path*"
    },
    {
      "source": "/pixabay/:path*",
      "destination": "https://cdn.pixabay.com/:path*"
    },
    {
      "source": "/wiki/:path*",
      "destination": "https://upload.wikimedia.org/:path*"
    }
  ]
}
